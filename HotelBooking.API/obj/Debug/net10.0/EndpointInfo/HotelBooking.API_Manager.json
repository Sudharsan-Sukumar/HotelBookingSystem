  "components": {
    "schemas": {
      "HotelRequestDto": {
        "required": [
          "city",
          "country",
          "description",
          "isActive",
          "location",
          "name",
          "starRating",
          "state",
          "zipCode"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9\\s\\&\\'\\-\\,]{3,100}$",
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "pattern": "^[^<>{}]+$",
            "type": "string"
          },
          "location": {
            "minLength": 1,
            "pattern": "^[^<>{}]+$",
            "type": "string"
          },
          "city": {
            "minLength": 1,
            "pattern": "^[a-zA-Z\\s\\.\\-]{2,80}$",
            "type": "string"
          },
          "state": {
            "minLength": 1,
            "pattern": "^[a-zA-Z\\s\\.\\-]{2,80}$",
            "type": "string"
          },
          "country": {
            "minLength": 1,
            "pattern": "^[a-zA-Z\\s\\.\\-]{2,80}$",
            "type": "string"
          },
          "zipCode": {
            "minLength": 1,
            "pattern": "^[1-9][0-9]{5}$",
            "type": "string"
          },
          "starRating": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          },
          "rowVersion": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PricingOverrideRequestDto": {
        "required": [
          "endDate",
          "price",
          "roomTypeId",
          "startDate"
        ],
        "type": "object",
        "properties": {
          "roomTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "price": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "RoomTypeRequestDto": {
        "required": [
          "basePrice",
          "capacity",
          "description",
          "name",
          "totalRooms"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "pattern": "^[^<>{}]+$",
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "basePrice": {
            "maximum": 100000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "capacity": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "totalRooms": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer {token}\"",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}