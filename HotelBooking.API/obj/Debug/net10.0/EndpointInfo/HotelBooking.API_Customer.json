              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              },
              "example": {"email":"admin@hotelbooking.com","password":"Password123!"}
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              },
              "example": {"email":"admin@hotelbooking.com","password":"Password123!"}
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              },
              "example": {"email":"admin@hotelbooking.com","password":"Password123!"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              },
